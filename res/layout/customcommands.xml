<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_nethunter">

    <LinearLayout
        android:id="@+id/f_customcommands_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_home_panel"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text="CUSTOM COMMANDS"
            android:textColor="@color/home_nh_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/f_customcommands_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/custom_commands_description"
            android:textColor="@color/home_nh_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <com.offsec.nethunter.widget.SubtleBounceRecyclerView
        android:id="@+id/f_customcommands_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_panel"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toBottomOf="@+id/f_customcommands_header"
        app:layout_constraintBottom_toTopOf="@+id/f_customcommands_btn_scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/f_customcommands_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="No commands found. Add a command to get started."
        android:textColor="@color/home_nh_muted"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/f_customcommands_recyclerview"
        app:layout_constraintStart_toStartOf="@+id/f_customcommands_recyclerview"
        app:layout_constraintEnd_toEndOf="@+id/f_customcommands_recyclerview" />

    <FrameLayout
        android:id="@+id/f_customcommands_btn_scrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_panel"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@+id/f_customcommands_recyclerview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/f_customcommands_linearlayoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_customcommands_addItemButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="Add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_customcommands_deleteItemButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="Delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_customcommands_moveItemButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="Move" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
