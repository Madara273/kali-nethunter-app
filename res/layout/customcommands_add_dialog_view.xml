<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_home_sheet" android:scrollbars="none" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp"
        android:paddingEnd="16dp" android:paddingBottom="16dp">
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_home_sheet_handle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Add command" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/home_nh_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:text="Create a custom command"
            android:textColor="@color/home_nh_muted" android:textSize="12sp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Home.Dialog.Field" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:hint="Label">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/f_customcommands_add_adb_et_label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:textColor="@color/home_nh_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Home.Dialog.Field" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:hint="Command">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/f_customcommands_add_adb_et_command"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" android:textColor="@color/home_nh_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" android:text="Send to"
            android:textColor="@color/home_nh_muted" android:textSize="13sp" />
        <com.offsec.nethunter.widget.ExpandableChoiceView android:id="@+id/f_customcommands_add_adb_spr_sendto"
            style="@style/Home.Dialog.Choice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:entries="@array/custom_commands_sendto_array" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:text="Execution mode"
            android:textColor="@color/home_nh_muted" android:textSize="13sp" />
        <com.offsec.nethunter.widget.ExpandableChoiceView android:id="@+id/f_customcommands_add_adb_spr_execmode"
            style="@style/Home.Dialog.Choice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:entries="@array/custom_commands_execmode_array" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/f_customcommands_add_adb_checkbox_runonboot"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:buttonTint="@color/home_nh_accent"
            android:text="Run on boot" android:textColor="@color/home_nh_text" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="8dp"
            android:text="Insert position" android:textColor="@color/home_nh_muted" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.offsec.nethunter.widget.ExpandableChoiceView android:id="@+id/f_customcommands_add_adb_spr_positions"
                style="@style/Home.Dialog.Choice" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="4dp"
                android:entries="@array/array_insert_position" />
            <com.offsec.nethunter.widget.ExpandableChoiceView android:id="@+id/f_customcommands_add_adb_spr_labels"
                style="@style/Home.Dialog.Choice" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/customcommands_add_cancel_btn" style="@style/Home.Dialog.Cancel"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancel" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/customcommands_add_save_btn" style="@style/Home.Dialog.Action"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="Save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
