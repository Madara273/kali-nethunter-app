<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_tech_gradient" android:theme="@style/ThemeOverlay.Home.Controls">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp" android:background="@drawable/bg_home_panel" android:orientation="vertical" android:padding="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="MAC CHANGER" android:textColor="@color/home_nh_accent" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Interface addresses and hostname" android:textColor="@color/home_nh_muted" android:textSize="12sp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:overScrollMode="never" android:layout_marginTop="8dp" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:background="@drawable/bg_home_panel" android:padding="12dp">
                <com.google.android.material.textfield.TextInputLayout style="@style/Home.Dialog.Field" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hostname">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/f_macchanger_phone_name_et" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="textUri" android:textColor="@color/home_nh_text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/f_macchanger_setHostname_btn" style="@style/Home.Button.NetHunter" android:layout_width="112dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:text="Set hostname" android:textColor="@color/home_nh_accent" android:gravity="center" app:backgroundTint="@color/home_nh_control" app:cornerRadius="10dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_home_panel">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Network interface" android:textSize="14sp" android:textColor="@color/home_nh_muted" />
                <com.offsec.nethunter.widget.ExpandableChoiceView android:id="@+id/f_macchanger_interface_opts_spr" style="@style/Home.Dialog.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_home_panel" android:padding="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Current MAC" android:textSize="14sp" android:textColor="@color/home_nh_muted" />
                        <TextView android:id="@+id/f_macchanger_currMac_tv" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:fontFamily="monospace" android:textSize="17sp" android:textColor="@color/home_nh_text" android:textIsSelectable="true" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/f_macchanger_reloadMAC_imgbtn" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Refresh interfaces" app:srcCompat="@drawable/ic_action_refresh" app:tint="@color/home_nh_accent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_home_panel" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New MAC address" android:textColor="@color/home_nh_accent" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Generate a local address or enter six hexadecimal pairs." android:textColor="@color/home_nh_muted" android:textSize="14sp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="Address mode" android:textSize="14sp" android:textColor="@color/home_nh_muted" />
                <com.offsec.nethunter.widget.ExpandableChoiceView android:id="@+id/f_macchanger_mode_opts_spr" style="@style/Home.Dialog.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/macchanger_opts" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/f_macchanger_mac1_et" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_macchanger_octet" android:gravity="center" android:padding="0dp" android:fontFamily="monospace" android:textSize="16sp" android:textColor="@color/home_nh_text" android:textColorHint="@color/home_nh_muted" android:hint="00" android:singleLine="true" android:digits="0123456789abcdefABCDEF" android:inputType="textNoSuggestions" android:maxLength="2" android:contentDescription="MAC address octet 1" />
                    <TextView android:layout_width="8dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="@color/home_nh_muted" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/f_macchanger_mac2_et" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_macchanger_octet" android:gravity="center" android:padding="0dp" android:fontFamily="monospace" android:textSize="16sp" android:textColor="@color/home_nh_text" android:textColorHint="@color/home_nh_muted" android:hint="00" android:singleLine="true" android:digits="0123456789abcdefABCDEF" android:inputType="textNoSuggestions" android:maxLength="2" android:contentDescription="MAC address octet 2" />
                    <TextView android:layout_width="8dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="@color/home_nh_muted" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/f_macchanger_mac3_et" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_macchanger_octet" android:gravity="center" android:padding="0dp" android:fontFamily="monospace" android:textSize="16sp" android:textColor="@color/home_nh_text" android:textColorHint="@color/home_nh_muted" android:hint="00" android:singleLine="true" android:digits="0123456789abcdefABCDEF" android:inputType="textNoSuggestions" android:maxLength="2" android:contentDescription="MAC address octet 3" />
                    <TextView android:layout_width="8dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="@color/home_nh_muted" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/f_macchanger_mac4_et" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_macchanger_octet" android:gravity="center" android:padding="0dp" android:fontFamily="monospace" android:textSize="16sp" android:textColor="@color/home_nh_text" android:textColorHint="@color/home_nh_muted" android:hint="00" android:singleLine="true" android:digits="0123456789abcdefABCDEF" android:inputType="textNoSuggestions" android:maxLength="2" android:contentDescription="MAC address octet 4" />
                    <TextView android:layout_width="8dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="@color/home_nh_muted" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/f_macchanger_mac5_et" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_macchanger_octet" android:gravity="center" android:padding="0dp" android:fontFamily="monospace" android:textSize="16sp" android:textColor="@color/home_nh_text" android:textColorHint="@color/home_nh_muted" android:hint="00" android:singleLine="true" android:digits="0123456789abcdefABCDEF" android:inputType="textNoSuggestions" android:maxLength="2" android:contentDescription="MAC address octet 5" />
                    <TextView android:layout_width="8dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="@color/home_nh_muted" />
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/f_macchanger_mac6_et" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_macchanger_octet" android:gravity="center" android:padding="0dp" android:fontFamily="monospace" android:textSize="16sp" android:textColor="@color/home_nh_text" android:textColorHint="@color/home_nh_muted" android:hint="00" android:singleLine="true" android:digits="0123456789abcdefABCDEF" android:inputType="textNoSuggestions" android:maxLength="2" android:contentDescription="MAC address octet 6" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/f_macchanger_regenerate_mac_btn" style="@style/Home.Button.NetHunter" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Generate address" />
                <com.google.android.material.button.MaterialButton android:id="@+id/f_macchanger_clear_mac_btn" style="@style/Home.Button.NetHunter" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Clear address" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_home_panel" android:padding="4dp" android:orientation="horizontal" android:layout_marginTop="12dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/f_macchanger_set_mac_btn" style="@style/Home.Button.NetHunter" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="Apply MAC" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/f_macchanger_reset_mac_btn" style="@style/Home.Button.NetHunter" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="Reset MAC" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
