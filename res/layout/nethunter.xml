<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home_nethunter">

    <LinearLayout
        android:id="@+id/f_nethunter_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_home_panel"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/f_nethunter_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:gravity="center"
            android:text="@string/nethunter_system_information"
            android:textColor="@color/home_nh_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/f_nethunter_banner2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="@string/nethunter_description"
            android:textColor="@color/home_nh_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <com.offsec.nethunter.widget.SubtleBounceRecyclerView
        android:id="@+id/f_nethunter_recyclerview"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_panel"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/f_nethunter_header"
        app:layout_constraintBottom_toTopOf="@+id/f_nethunter_btn_scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/f_nethunter_btn_scrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_panel"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@+id/f_nethunter_recyclerview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/f_nethunter_linearlayoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_nethunter_refreshButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="@string/nethunter_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_nethunter_addItemButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="@string/nethunter_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_nethunter_deleteItemButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="@string/nethunter_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/f_nethunter_moveItemButton"
                style="@style/Home.Button.NetHunter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="@string/nethunter_move" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
