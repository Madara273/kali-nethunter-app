<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Home.Button.NetHunter" parent="Tech.Button.Primary.Compact">
        <item name="android:backgroundTint">@color/home_nh_control</item>
        <item name="android:textColor">@color/home_nh_accent</item>
        <item name="strokeColor">@color/home_nh_border</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="ThemeOverlay.Home.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/home_nh_accent</item>
        <item name="colorOnPrimary">@color/home_nh_bg_start</item>
        <item name="colorSurface">@color/home_nh_surface</item>
        <item name="colorOnSurface">@color/home_nh_text</item>
        <item name="colorOutline">@color/home_nh_border</item>
        <item name="colorControlActivated">@color/home_nh_accent</item>
    </style>

    <style name="ThemeOverlay.Home.Controls" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/home_nh_accent</item>
        <item name="colorOnSurface">@color/home_nh_text</item>
        <item name="colorSurface">@color/home_nh_surface</item>
        <item name="colorControlActivated">@color/home_nh_accent</item>
    </style>

    <style name="ThemeOverlay.Home.Alert" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/home_nh_accent</item>
        <item name="colorOnPrimary">@color/home_nh_bg_start</item>
        <item name="colorSurface">@color/home_nh_surface</item>
        <item name="colorOnSurface">@color/home_nh_text</item>
        <item name="colorOutline">@color/home_nh_border</item>
        <item name="colorControlActivated">@color/home_nh_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Home.Dialog.AlertButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Home.Dialog.AlertButton</item>
    </style>

    <style name="Home.Dialog.AlertButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/home_nh_accent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Home.Dialog.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/home_field_stroke</item>
        <item name="hintTextColor">@color/home_nh_accent</item>
        <item name="android:textColorHint">@color/home_nh_muted</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="Home.Dialog.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/home_field_stroke</item>
        <item name="hintTextColor">@color/home_nh_accent</item>
        <item name="android:textColorHint">@color/home_nh_muted</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="Home.Dialog.Choice" parent="">
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Home.Dialog.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_home_spinner</item>
        <item name="android:popupBackground">@color/home_nh_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Home.Dialog.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/home_nh_border</item>
        <item name="backgroundTint">@color/home_dialog_toggle_background</item>
        <item name="android:textColor">@color/home_dialog_toggle_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Home.Dialog.Action" parent="Home.Button.NetHunter">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Home.Dialog.Cancel" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/home_nh_muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Home.Dialog.MoreAction" parent="Home.Dialog.Action">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
